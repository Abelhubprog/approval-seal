  "canonical_valid": [
    {
      "expected": "null",
      "input_json": "null",
      "name": "null"
    },
    {
      "expected": "true",
      "input_json": "true",
      "name": "true"
    },
    {
      "expected": "false",
      "input_json": "false",
      "name": "false"
    },
    {
      "expected": "0",
      "input_json": "0",
      "name": "zero"
    },
    {
      "expected": "-42",
      "input_json": "-42",
      "name": "negative int"
    },
    {
      "expected": "9007199254740991",
      "input_json": "9007199254740991",
      "name": "max safe int"
    },
    {
      "expected": "{}",
      "input_json": "{}",
      "name": "empty object"
    },
    {
      "expected": "[]",
      "input_json": "[]",
      "name": "empty array"
    },
    {
      "expected": "{\"B\":3,\"a\":2,\"b\":1}",
      "input_json": "{\"b\":1,\"a\":2,\"B\":3}",
      "name": "key order"
    },
    {
      "expected": "{\"a\":[1,2],\"b\":{\"c\":null}}",
      "input_json": "{ \"a\" : [ 1 , 2 ] , \"b\" : { \"c\" : null } }",
      "name": "whitespace removed"
    },
    {
      "expected": "{\"a\":[{\"c\":2,\"d\":1}],\"z\":{\"x\":2,\"y\":1}}",
      "input_json": "{\"z\":{\"y\":1,\"x\":2},\"a\":[{\"d\":1,\"c\":2}]}",
      "name": "nested sort"
    },
    {
      "expected": "\"quote\\\" backslash\\\\ nl\\n tab\\t bs\\b ff\\f cr\\r\"",
      "input_json": "\"quote\\\" backslash\\\\ nl\\n tab\\t bs\\b ff\\f cr\\r\"",
      "name": "string escapes"
    },
    {
      "expected": "\"\\u0001\\u001f\"",
      "input_json": "\"\\u0001\\u001f\"",
      "name": "control char"
    },
    {
      "expected": "\"\\u007f\"",
      "input_json": "\"\\u007f\"",
      "name": "del is escaped"
    },
    {
      "expected": "\"caf\\u00e9 \\u00c9\"",
      "input_json": "\"caf\\u00e9 \\u00C9\"",
      "name": "non-ascii escaped lowercase"
    },
    {
      "expected": "\"\\ud83d\\ude00\"",
      "input_json": "\"\\ud83d\\ude00\"",
      "name": "astral becomes surrogate pair"
    },
    {
      "expected": "\"\\ud83d\\ude00\"",
      "input_json": "\"\ud83d\ude00\"",
      "name": "astral raw utf8 input"
    },
    {
      "expected": "{\"\\uffee\":2,\"\\ud83d\\ude00\":1}",
      "input_json": "{\"\\ud83d\\ude00\":1,\"\\uffee\":2}",
      "name": "keys sorted by code point not utf16"
    },
    {
      "expected": "{\"px\":\"2500.0\",\"size\":\"0.0100\"}",
      "input_json": "{\"size\":\"0.0100\",\"px\":\"2500.0\"}",
      "name": "decimal strings stay strings"
    },
    {
      "expected": "\"a/b\"",
      "input_json": "\"a/b\"",
      "name": "slash is not escaped"
    }
  ],
